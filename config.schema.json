              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "off",
                    "none",
                    "default",
                    "low",
                    "minimal",
                    "medium",
                    "high",
                    "xhigh",
                    "max",
                    "ultra"
                  ]
                }
              ],
              "description": "Reasoning effort level for providers that support it, or boolean tri-state"
            },
            "apiType": {
              "type": "string",
              "enum": [
                "openai-chat",
                "openai-responses",
                "anthropic"
              ],
              "description": "Provider API type"
            },
            "contextWindow": {
              "type": "integer",
              "minimum": 1
            },
            "maxInputTokens": {
              "type": "integer",
              "minimum": 1
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
