{
  "version": "1.8.0",
  "tasks": {
    "prepare": "husky || true"
  },
  "imports": {
    "ai": "npm:ai@^6.0.240",
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@^3.0.104",
    "@ai-sdk/deepseek": "npm:@ai-sdk/deepseek@^2.0.51",
    "@ai-sdk/google": "npm:@ai-sdk/google@^3.0.103",
    "@ai-sdk/mistral": "npm:@ai-sdk/mistral@^3.0.53",
    "@ai-sdk/moonshotai": "npm:@ai-sdk/moonshotai@^2.0.40",
    "@ai-sdk/openai": "npm:@ai-sdk/openai@^3.0.90",
    "@ai-sdk/xai": "npm:@ai-sdk/xai@^3.0.113",
    "@openrouter/ai-sdk-provider": "npm:@openrouter/ai-sdk-provider@^2.10.0",
    "ollama-ai-provider-v2": "npm:ollama-ai-provider-v2@^3.6.0",
    "vercel-minimax-ai-provider": "npm:vercel-minimax-ai-provider@^0.0.2",
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@cliffy/flags": "jsr:@cliffy/flags@^1.2.1",
    "@cliffy/table": "jsr:@cliffy/table@^1.2.1",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1",
    "@std/fmt": "jsr:@std/fmt@1.0.10",
    "axios": "npm:axios@1.19.0",
    "husky": "npm:husky@^9.1.7",
    "lib-result": "npm:lib-result@^5.0.0",
    "zod": "npm:zod@^4.4.3",
    "@/": "./src/"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-unused-vars",
        "no-explicit-any",
        "ban-types",
        "no-fallthrough"
      ]
    }
  },
  "nodeModulesDir": "auto"
}
